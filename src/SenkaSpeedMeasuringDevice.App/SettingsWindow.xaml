<Window x:Class="SenkaSpeedMeasuringDevice.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" SizeToContent="WidthAndHeight" MinWidth="430" MaxWidth="560"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16">
        <TextBlock Text="外観" FontWeight="Bold" Margin="0,0,0,8" />
        <CheckBox x:Name="DarkModeCheck" Content="ダークモード" Margin="0,3" />
        <TextBlock Text="フォント" Margin="0,10,0,3" />
        <ComboBox x:Name="FontFamilyBox" MinWidth="300" />
        <TextBlock Text="フォントサイズ" Margin="0,10,0,3" />
        <StackPanel Orientation="Horizontal">
            <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="24" TickFrequency="1"
                    IsSnapToTickEnabled="True" Width="250" />
            <TextBlock x:Name="FontSizeValue" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox x:Name="AlwaysOnTopCheck" Content="常に最前面に表示 (74ENに取り込む場合はOFF)" Margin="0,12,0,0" />
        <CheckBox x:Name="AutoStartCheck" Content="Windowsログオン時に自動起動" Margin="0,8,0,0" />
        <Separator Margin="0,14,0,10" />
        <TextBlock Text="通信設定" FontWeight="Bold" Margin="0,0,0,6" />
        <CheckBox x:Name="DirectCaptureCheck" Content="ブラウザから直接取得する" Margin="0,3"
                  Checked="DirectCapture_Changed" Unchecked="DirectCapture_Changed" />
        <StackPanel x:Name="BrowserSettingsPanel" Margin="18,3,0,0">
            <TextBlock Text="使用ブラウザ" Margin="0,4,0,3" />
            <ComboBox x:Name="BrowserBox" MinWidth="330" DisplayMemberPath="Name" SelectionChanged="Browser_SelectionChanged" />
            <TextBlock x:Name="BrowserSupportText" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,4" />
            <TextBlock Text="所属サーバー" Margin="0,5,0,3" />
            <ComboBox x:Name="GameServerBox" MinWidth="330" DisplayMemberPath="Name" SelectedValuePath="Id" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                <Button x:Name="PrepareLoginButton" Content="ログイン準備" HorizontalAlignment="Left"
                        Padding="10,4" Margin="0,0,8,0" Click="PrepareLogin_Click" />
                <Button x:Name="StartMeasurementButton" Content="計測開始" HorizontalAlignment="Left"
                        Padding="10,4" Click="StartMeasurement_Click" />
            </StackPanel>
            <TextBlock Text="ログイン準備ではCDP接続を行いません。認証後、開いた専用ブラウザを自分で閉じてから計測開始してください。計測機はブラウザを終了しません。"
                       TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        <CheckBox x:Name="JsonCaptureCheck" Content="74ENのJSONファイルから取得する" Margin="0,9,0,2"
                  Checked="JsonCapture_Changed" Unchecked="JsonCapture_Changed" />
        <Expander x:Name="DetailsExpander" Header="詳細情報" Margin="0,8,0,0" IsExpanded="False">
            <StackPanel Margin="12,6,0,0">
                <TextBlock Text="対象ゲームページ" FontSize="11" />
                <TextBox Text="https://play.games.dmm.com/game/kancolle" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         BorderThickness="0" Background="Transparent" FontSize="11" />
                <TextBlock Text="対象APIパス: /kcsapi/api_port/port" FontSize="11" Margin="0,4,0,0" />
                <TextBlock x:Name="ApiHostText" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="CDPポート (計測開始時に自動入力)" Margin="0,8,0,3" FontSize="11" />
                <TextBox x:Name="CdpPortBox" Text="9222" Width="120" HorizontalAlignment="Left" />
                <TextBlock Text="通常認証とCDP計測は同じ専用プロファイルを使います。計測機の終了後もブラウザのデバッグ待受はブラウザ終了まで残ります。"
                           TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
        </Expander>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="適用" Width="84" IsDefault="True" Click="Apply_Click" />
            <Button Content="閉じる" Width="84" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
