<Window x:Class="SenkaSpeedMeasuringDevice.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" SizeToContent="WidthAndHeight" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="外観" FontWeight="Bold" Margin="0,0,0,8" />
        <CheckBox x:Name="DarkModeCheck" Content="ダークモード" Margin="0,3" />
        <TextBlock Text="フォント" Margin="0,10,0,3" />
        <ComboBox x:Name="FontFamilyBox" MinWidth="300" />
        <TextBlock Text="フォントサイズ" Margin="0,10,0,3" />
        <StackPanel Orientation="Horizontal">
            <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="24" TickFrequency="1"
                    IsSnapToTickEnabled="True" Width="250" />
            <TextBlock x:Name="FontSizeValue" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox x:Name="AlwaysOnTopCheck" Content="常に最前面に表示 (74ENに取り込む場合はOFF)" Margin="0,12,0,0" />
        <CheckBox x:Name="AutoStartCheck" Content="Windowsログオン時に自動起動" Margin="0,8,0,0" />
        <Separator Margin="0,14,0,10" />
        <TextBlock Text="データ取得" FontWeight="Bold" Margin="0,0,0,6" />
        <CheckBox x:Name="CdpEnabledCheck" Content="CDPで通常ブラウザを監視する" Margin="0,3" />
        <TextBlock Text="CDPは専用ブラウザのloopback設定が必要です。本アプリはブラウザ設定を変更しません。" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6" />
        <TextBlock Text="CDPポート" />
        <TextBox x:Name="CdpPortBox" Text="9222" />
        <TextBlock Text="対象ページの完全なURL" Margin="0,6,0,0" />
        <TextBox x:Name="CdpPageUrlBox" />
        <TextBlock Text="APIホスト (複数はカンマ区切り)" Margin="0,6,0,0" />
        <TextBox x:Name="CdpApiHostsBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="適用" Width="84" IsDefault="True" Click="Apply_Click" />
            <Button Content="閉じる" Width="84" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

