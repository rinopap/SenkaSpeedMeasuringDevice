<Window x:Class="SenkaSpeedMeasuringDevice.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" SizeToContent="WidthAndHeight" MinWidth="430" MaxWidth="560"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#202124" />
        <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#5F6368" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#DADCE0" />
        <SolidColorBrush x:Key="AppSelectedTabBrush" Color="#D2E3FC" />
        <SolidColorBrush x:Key="AppSelectedTabForegroundBrush" Color="#174EA6" />
        <SolidColorBrush x:Key="AppHoverBrush" Color="#E8F0FE" />
        <SolidColorBrush x:Key="AppFocusBrush" Color="#1A73E8" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="データ取得" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock x:Name="MigrationNotice" TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,0,0,8" />
            <ComboBox x:Name="CaptureModeBox" MinWidth="380" SelectionChanged="CaptureMode_Changed" />

            <StackPanel x:Name="SqliteSettingsPanel" Margin="16,8,0,0">
                <TextBlock Text="検出した74ENデータベース" Margin="0,2,0,3" />
                <ComboBox x:Name="DetectedDatabaseBox" DisplayMemberPath="DisplayName"
                          SelectionChanged="DetectedDatabase_Changed" />
                <TextBlock Text="使用するElectronicObserver.sqlite" Margin="0,7,0,3" />
                <DockPanel>
                    <Button Content="参照…" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,3"
                            Click="BrowseSqlite_Click" />
                    <TextBox x:Name="SqliteDatabasePathBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="74ENのSQLiteは読み取り専用で開きます。計測機から74ENを起動・終了しません。"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
                <Button x:Name="NewMeasurementSessionButton" Content="新しい計測区間を開始"
                        HorizontalAlignment="Left" Padding="9,4" Margin="0,10,0,0"
                        Click="NewMeasurementSession_Click" />
                <TextBlock Text="提督を切り替えるときは新しい計測区間を開始してください。区間は再起動後も維持されます。"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel x:Name="JsonSettingsPanel" Margin="16,8,0,0">
                <TextBlock Text="74EN JSON応答フォルダ" Margin="0,2,0,3" />
                <DockPanel>
                    <Button Content="参照…" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,3"
                            Click="BrowseJson_Click" />
                    <TextBox x:Name="JsonResponseDirectoryBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="JSON方式は従来の全所持艦累積経験値差分を使います。SQLite方式のAPI獲得経験値とは指標が異なります。"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>

            <Separator Margin="0,14,0,10" />
            <TextBlock Text="外観" FontWeight="Bold" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <CheckBox x:Name="DarkModeCheck" Content="ダークモード" Margin="0,3" />
                    <TextBlock Text="フォント" Margin="0,10,0,3" />
                    <ComboBox x:Name="FontFamilyBox" MinWidth="260" />
                    <TextBlock Text="フォントサイズ (pt)" Margin="0,10,0,3" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="24" TickFrequency="1"
                                IsSnapToTickEnabled="True" Width="210" />
                        <TextBlock x:Name="FontSizeValue" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="AppearancePreviewCard" Grid.Column="1" Margin="0,3,0,0"
                        Padding="10" BorderThickness="1" CornerRadius="5"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        Background="{DynamicResource AppBackgroundBrush}"
                        VerticalAlignment="Center" AutomationProperties.Name="外観プレビュー">
                    <StackPanel>
                        <TextBlock Text="プレビュー" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border x:Name="AppearancePreviewTab" Padding="7,3" CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AppSelectedTabBrush}">
                            <TextBlock x:Name="AppearancePreviewTabText" Text="Exp時速"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppSelectedTabForegroundBrush}" />
                        </Border>
                        <TextBlock x:Name="AppearancePreviewValue" Text="123,456"
                                   FontWeight="Bold" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
            <CheckBox x:Name="AlwaysOnTopCheck" Content="常に最前面に表示 (74ENに取り込む場合はOFF)" Margin="0,12,0,0" />
            <CheckBox x:Name="AutoStartCheck" Content="Windowsログオン時に自動起動" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="適用" Width="84" IsDefault="True" Click="Apply_Click" />
                <Button Content="閉じる" Width="84" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
