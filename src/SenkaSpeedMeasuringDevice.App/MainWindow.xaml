<Window x:Class="SenkaSpeedMeasuringDevice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="戦果時速計測機" Height="210" Width="380"
        MinHeight="180" MinWidth="340" WindowStartupLocation="CenterScreen">
    <Grid x:Name="MainRoot" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTabs" Grid.Row="0">
            <TabItem Header="戦果時速">
                <TextBlock x:Name="AdmiralDisplay" Margin="8" FontWeight="Bold" Text="データなし" />
            </TabItem>
            <TabItem Header="艦娘Exp時速">
                <TextBlock x:Name="ShipDisplay" Margin="8" FontWeight="Bold" Text="データなし" />
            </TabItem>
        </TabControl>
        <TextBlock x:Name="CaptureStatus" Grid.Row="1" Margin="0,10,96,0"
                   VerticalAlignment="Center" Text="取得元を準備中" FontSize="10" TextTrimming="CharacterEllipsis" />
        <Button x:Name="SettingsButton" Grid.Row="1" Content="⚙ 設定" Width="84" Margin="0,6,0,0"
                HorizontalAlignment="Right" Click="SettingsButton_Click" />
    </Grid>
</Window>

